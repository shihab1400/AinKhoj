# Copy to .env. Never commit .env.

# ---------------- Gemini (Google AI Studio) ----------------
# Used for general questions and (by default) for the router.
GEMINI_API_KEY=
# "-latest" aliases always point at Google's newest model of that size ("auto").
GENERAL_MODEL=gemini-flash-latest

# ---------------- Router: legal question? which law? ----------------
# gemini = fast and accurate (recommended). lmstudio = fully local but slower.
ROUTER_PROVIDER=gemini
ROUTER_MODEL=gemini-flash-lite-latest

# ---------------- Who writes the LEGAL answers ----------------
# lmstudio = your local Gemma, gemini = Gemini (uses GEMINI_MODEL below)
LLM_PROVIDER=lmstudio
GEMINI_MODEL=gemini-flash-latest
LMSTUDIO_URL=http://localhost:1234/v1
# Exact id: open http://localhost:1234/v1/models in your browser
LMSTUDIO_CHAT_MODEL=gemma-4-e4b-it

# ---------------- Law search (Python service) ----------------
RETRIEVAL_URL=http://localhost:8000
TOP_K=5
# Ignore weak matches below this cosine score (0 = off). Tune after testing.
MIN_SCORE=0

# ---------------- Firebase ----------------
# Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

FRONTEND_URL=http://localhost:3000
PORT=4000
